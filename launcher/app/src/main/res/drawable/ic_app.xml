<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#1E2A44" android:endColor="#06070A" android:angle="315" />
            <size android:width="320dp" android:height="180dp" />
        </shape>
    </item>
    <item android:gravity="center" android:width="96dp" android:height="58dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#40FFFFFF" />
            <stroke android:width="2dp" android:color="#80FFFFFF" />
        </shape>
    </item>
</layer-list>
